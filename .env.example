DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=social_media
DB_USER=root
DB_PASSWORD=
# Optional; default resolves to C:\xampp\social-media-private on Windows.
# Keep this folder outside the public web root and source control.
GA4_CREDENTIAL_DIR=
# Required to enable NFC administration. Use a randomly generated secret
# containing at least 32 characters. It is never sent to the client bundle.
NFC_ADMIN_TOKEN=
# Required in production. Local development defaults to the current localhost
# origin. Example: https://reviews.example.com
NFC_PUBLIC_BASE_URL=
